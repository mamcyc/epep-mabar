UPTIME = os.time()

if getBot().index == 1 then
    runThread(function(link, id, result_file_name, UPTIME)
        local succ, err = pcall(function()
            io.lines(result_file_name)
        end)
        function many_world()
            strings = ""
            if succ then
                for _ in io.lines(result_file_name) do
                    strings = strings .. "> ".. _ .. "\n"
                end
                print(strings)
            else
                strings = "Not Ready"
            end
            return strings
        end

        function get_bot()
            online_bot = 0
            offline_bot = 0
            for _, bot in ipairs(getBots()) do
                if bot.status == BotStatus.online then
                    online_bot = online_bot + 1
                else
                    offline_bot = offline_bot + 1
                end
            end

            return ("<a:onlineping:1268059019751194697> Online: %d\n<a:offline:1270929608950153217> Offline: %d"):format(online_bot, offline_bot)
        end

        
        WH = Webhook.new(link)
        WH.embed1.use = true
        WH.embed1:addField("Uptime Script", ("<t:%d:R>"):format(UPTIME),false)
        WH.embed1.title = "Versatile Dirt Farm"
        WH.embed1.thumbnail = "https://cdn.discordapp.com/icons/786603300446666812/a58d00d8013ce76e8fb2fc432bdf7388.png?size=4096"
        WH.embed1.color = 1179451

        while true do
            WH.embed1.description = get_bot().."\n\n".."**LIST WORLD DONE**\n"..many_world()
            WH:edit(id)
            sleep(60000)
        end
    end, Webhooks.link, Webhooks.id, World.result_file_name, UPTIME)

end




function main(bot, tables, Bot_Settings, Script_Settings)
    

    function random_word()
        kata_indonesia = {
        "apakah", "besar", "cinta", "dunia", "enak", "fakta", "gembira", "hari",
        "indah", "jangan", "kecil", "laju", "manis", "nasi", "oleh", "penuh",
        "qurban", "rindu", "sangat", "tunggu", "warna", "yakin", "zaman",
        "sehat", "pintar", "cerita", "selamat", "aktivitas", "bintang", "cahaya",
        "damai", "ekonomi", "fajar", "gembira", "hujan", "istirahat", "juara",
        "kemenangan", "lagu", "momen", "nalar", "olahraga", "perjuangan", "rasa",
        "suara", "teman", "usaha", "visi", "waktu", "xenon", "yoga", "zodiak"
        }
        word = ""
        for i = 1, math.random(6, 12) do
            word = word .. " " .. kata_indonesia[math.random(1, #kata_indonesia)]
        end
        return word
    end

    function punch(tile_x, tile_y)
        if getLocal().posx then
            return getBot():hit(getLocal().posx // 32 + tile_x, getLocal().posy // 32 + tile_y)
        end
        return nil
    end

    function place(item_id, tile_x, tile_y)
        if getLocal().posx then
            return getBot():place(getLocal().posx // 32 + tile_x, getLocal().posy // 32 + tile_y, item_id)
        end
        return nil
    end

    function findItem(item_id)
        return getBot():getInventory():getItemCount(item_id)
    end

    function drop(item_id, count)
        return getBot():fastDrop(item_id, count)
    end

    function warp(world_name, world_door)
        _G.last_world = world_name
        _G.last_door = world_door

        
        getBot():warp(world_name)
        sleep(1520)
        while not getBot():isInWorld(world_name:upper()) do
            getBot():warp(world_name)
            dynamic_sleep(6000)
            reconnect()
        end
        ::BEK::
        main_x, main_y = getLocal().posx, getLocal().posy
        if getBot():isInWorld(world_name:upper()) then
            getBot():warp(world_name, world_door)
            dynamic_sleep(3000)
        end
        if main_x == getLocal().posx then
            goto BEK
        end
    end

    function find_path(tile_x, tile_y)
        _G.last_x = tile_x
        _G.last_y = tile_y

        while not getBot():isInTile(tile_x, tile_y) do
            getBot():findPath(tile_x, tile_y)
            dynamic_sleep(100)
        end
    end

    function take_float(item_id, count)
        for _, obj in pairs(getObjects()) do
            if obj.id == item_id then
                local path_x = obj.x // 32
                local path_y = obj.y // 32
    
                if #getBot():getPath(path_x, path_y) > 0 then
                    find_path(path_x, path_y)
                else
                    for x = -1, 1 do
                        for y = -1, 1 do
                            if #getBot():getPath(path_x, path_y) > 0 then
                                find_path(path_x + x, path_y + y)
                                goto PASS_FINDPATH
                            end
                        end
                    end
                end
                ::PASS_FINDPATH::
    
                while findItem(item_id) == 0 or findItem(item_id) < count do
                    getBot():collectObject(obj.oid, 3)
                    dynamic_sleep(3000)
                end
    
                getBot():setDirection(false)
    
                while findItem(item_id) > count do
                    getBot():findOutput()
                    dynamic_sleep(700)
                    drop(item_id, findItem(item_id) - count)
                end
    
                if findItem(item_id) == count then
                    return
                end
            end
        end
    end

    function reconnect()
        getBot():setSkin(math.random(1, 6))
        if getBot().status ~= BotStatus.online then
            while getBot().status ~= BotStatus.online do
                sleep(Bot_Settings.delay_reconnect * 1000)
                if getBot().status == BotStatus.account_banned then
                    getBot().auto_reconnect = false
                    error("Bot Banned")
                end
            end
    
            warp(_G.last_world, _G.last_door)
            find_path(_G.last_x, _G.last_y)
        end
    end


    function dropall()
        getBot().auto_collect = false
        for _, trash in pairs(Script_Settings.save_trash.trash_id) do
            for _, tile in pairs(getTiles()) do
                if tile.fg == Script_Settings.save_trash.pos_drop or tile.bg == Script_Settings.save_trash.pos_drop then
                    find_path(tile.x - 1, tile.y)
                    reconnect()
                    getBot():setDirection(false)
                    dynamic_sleep(100)
                    getBot():findOutput()
                    dynamic_sleep(700)
                    drop(trash, findItem(trash))
                    reconnect()
                    dynamic_sleep(700)
                end
                if findItem(trash) == 0 then
                    break
                end
            end
        end
    end

    function clear()
        for _, trash in pairs(Script_Settings.save_trash.trash_id) do
            if findItem(trash) >= 190 then
                if Script_Settings.save_trash.enabled then
                    warp(Script_Settings.save_trash.world_name, Script_Settings.save_trash.world_id)
                    dropall()
                    warp(_G.current_farm, _G.current_door)
                    getBot().auto_collect = true
                else
                    getBot():fastTrash(trash, findItem(trash))
                    dynamic_sleep(1500)
                end
            end
        end
    end

    function farm_dirt()
        for _, tile in pairs(getTiles()) do
            if tile.x >= 3 and tile.x <= 23 and ((tile.y == 25 and not Bot_Settings.multibot) or tile.y == (25 + 2 * (tables[2] - 1))) then
                if getTile(tile.x, tile.y):canHarvest() or (getTile(tile.x, tile.y).fg == 0 and findItem(3) > 0) then
                    find_path(tile.x, tile.y)
                    while getTile(tile.x, tile.y):canHarvest() do
                        punch(0, 0)
                        sleep(Bot_Settings.delay_punch)
                        reconnect()
                    end
    
                    while getTile(tile.x, tile.y).fg == 0 and findItem(3) > 0 do
                        place(3, 0, 0)
                        sleep(Bot_Settings.delay_punch)
                        reconnect()
                    end
                end
                if findItem(2) >= 100 then
                    break
                end
            end
        end
    end
    
    function scan_item(itemid)
        local count = 0
        for _, object in pairs(getObjects()) do
            if object.id == itemid then
                count = object.count + count
            end
        end
    
        return count
    end

    function random_say()
        local wise = math.random(1, 15)
    
        if wise == 3 or wise == 7 or wise == 15 and Bot_Settings.random_say then
            getBot():say(random_word())
        end
    end

    function dirtFarm()
        getBot().collect_range = 2
        random_say()
        for width = 0, 99 do
            for height = 23, 53 do
                if (function()
                        if Script_Settings.use_platform.enabled then
                            return (width <= 1 or width >= 98) and getTile(width, height).bg > 0
                        else
                            return (width == 0 or width == 99) and getTile(width, height).bg > 0
                        end
                    end)() then
                    reconnect()
                    find_path(width, height - 1)
                    while getTile(width, height).bg > 0 do
                        punch(0, 1)
                        dynamic_sleep(Bot_Settings.delay_punch)
                        reconnect()
                    end
                end
            end
        end
    
    
        random_say()
        if Script_Settings.use_platform.enabled then
            if not Bot_Settings.multibot or tables[2] == 1 then
                for _, tile in pairs(getTiles()) do
                    reconnect()
                    if findItem(Script_Settings.use_platform.plat_id) < 52 and findItem(Script_Settings.use_platform.plat_id) == 0 then
                        getBot().auto_collect = false
                        warp(Script_Settings.use_platform.world_name, Script_Settings.use_platform.world_id)
                        take_float(Script_Settings.use_platform.plat_id, 52)
                        warp(_G.current_farm, _G.current_door)
                        getBot().auto_collect = true
                    end
    
                    if tile.y % 2 == 0 and getTile(tile.x, tile.y).fg == 0 and tile.x == 1 and tile.y <= 53 and tile.y > 0 then
                        find_path(tile.x, tile.y - 1)
                        while getTile(tile.x, tile.y).fg == 0 do
                            place(Script_Settings.use_platform.plat_id, 0, 1)
                            dynamic_sleep(Bot_Settings.delay_place)
                            reconnect()
                        end
                    end
                end
    
                for _, tile in pairs(getTiles()) do
                    if tile.y % 2 == 0 and getTile(tile.x, tile.y).fg == 0 and tile.x == 98 and tile.y <= 53 and tile.y > 0 then
                        find_path(tile.x, tile.y - 1)
                        while getTile(tile.x, tile.y).fg == 0 do
                            place(Script_Settings.use_platform.plat_id, 0, 1)
                            dynamic_sleep(Bot_Settings.delay_place)
                            reconnect()
                        end
                    end
                end
            end
        end
    
        random_say()
        for _, tile in pairs(getTiles()) do
            if (not Bot_Settings.multibot or ((tile.y + 1) % Bot_Settings.spread) == tables[2] - 1) and tile.y % 2 == 1 and tile.y <= 53 and getTile(tile.x, tile.y).bg > 0 then
                find_path(tile.x - 1, tile.y)
                while getTile(tile.x, tile.y).bg > 0 do
                    punch(1, 0)
                    dynamic_sleep(Bot_Settings.delay_punch)
                    reconnect()
                end
            end
            clear()
        end
    
        random_say()
        for _, tile in pairs(getTiles()) do
            if tile.y % 2 == 1 and tile.y <= 53 and getTile(tile.x, tile.y).bg > 0 then
                find_path(tile.x - 1, tile.y)
                while getTile(tile.x, tile.y).bg > 0 do
                    punch(1, 0)
                    dynamic_sleep(Bot_Settings.delay_punch)
                    reconnect()
                end
            end
            clear()
        end
    
        random_say()
        for _, tile in pairs(getTiles()) do
            if getTile(tile.x, tile.y).fg == 4 then
                find_path(tile.x, tile.y - 1)
                while getTile(tile.x, tile.y).fg == 4 do
                    punch(0, 1)
                    dynamic_sleep(Bot_Settings.delay_punch)
                    reconnect()
                end
            end
        end
    
        checked = false
    
        random_say()
        ::BEK::
        if findItem(3) > 0 and not checked then
            for __, tile in pairs(getTiles()) do
                while findItem(2) == 0 and tile.y % 2 == 0 and getTile(tile.x, tile.y).fg == 0 and tile.x > 0 and tile.x < 99 and tile.y <= 53 and tile.y > 0 do
                    farm_dirt()
                    dynamic_sleep(1000)
                end
    
                if (not Bot_Settings.multibot or ((tile.y + 1) % (Bot_Settings.spread)) == tables[2] - 1) and tile.y % 2 == 0 and getTile(tile.x, tile.y).fg == 0 and tile.x > 0 and tile.x < 99 and tile.y <= 53 and tile.y > 0 then
                    find_path(tile.x, tile.y - 1)
                    while getTile(tile.x, tile.y).fg == 0 do
                        place(2, 0, 1)
                        dynamic_sleep(Bot_Settings.delay_place)
                        reconnect()
                    end
                end
            end
    
            for _, tile in pairs(getTiles()) do
                while findItem(2) == 0 and tile.y % 2 == 0 and getTile(tile.x, tile.y).fg == 0 and tile.x > 0 and tile.x < 99 and tile.y <= 53 and tile.y > 0 do
                    farm_dirt()
                    dynamic_sleep(10000)
                end
    
                if tile.y % 2 == 0 and getTile(tile.x, tile.y).fg == 0 and tile.x > 0 and tile.x < 99 and tile.y <= 53 and tile.y > 0 then
                    find_path(tile.x, tile.y - 1)
                    while getTile(tile.x, tile.y).fg == 0 do
                        place(2, 0, 1)
                        dynamic_sleep(Bot_Settings.delay_place)
                        reconnect()
                    end
                end
            end
        else
            warp(Script_Settings.save_trash.world_name, Script_Settings.save_trash.world_id)
            if scan_item(3) > 0 then
                if scan_item(3) >= 200 then
                    take_dirt = 200
                else
                    take_dirt = scan_item(3)
                end
                take_float(3, take_dirt)
            else
                checked = true
            end
            warp(_G.current_farm, _G.current_door)
            goto BEK
        end
    
        random_say()
        for __, tile in pairs(getTiles()) do
            if tile.fg == 3 and (not Bot_Settings.multibot or ((tile.y + 1) % Bot_Settings.spread) == tables[2] - 1) then
                find_path(tile.x, tile.y)
                while getTile(tile.x, tile.y).fg == 3 do
                    punch(0, 0)
                    dynamic_sleep(Bot_Settings.delay_punch)
                    reconnect()
                end
    
                clear()
            end
        end
    
        random_say()
        for __, tile in pairs(getTiles()) do
            if tile.fg == 3 then
                find_path(tile.x, tile.y)
                while getTile(tile.x, tile.y).fg == 3 do
                    punch(0, 0)
                    dynamic_sleep(Bot_Settings.delay_punch)
                    reconnect()
                end
                clear()
            end
        end
    end

    if Script_Settings.take_pickaxe.enabled and findItem(98) == 0 then
        warp(Script_Settings.take_pickaxe.world_name, Script_Settings.take_pickaxe.world_id)
        take_float(98, 1)

        while not getBot():getInventory():getItem(98).isActive do
            getBot():use(98)
            dynamic_sleep(5000)
        end
    end
    
    for _, world_name in ipairs(tables[1]) do
        _G.current_farm, _G.current_door = world_name:match("([^|]+)|([^|]+)")
        warp(_G.current_farm, _G.current_door)
        getBot().auto_collect = true
        getBot().collect_interval = 50
        dirtFarm()
        if tables[2] == 1 then
            append(World.result_file_name, _G.current_farm .. "|" .. _G.current_door .. "\n")
        end
    end
end

clearConsole()

if Bot_Settings.spread > 0 and Bot_Settings.multibot then
    WORLD_SPREAD = {}
    WORLD = {}
    BOTCOUNT = #getBots()
    
    for world in io.lines(World.file_name) do
        table.insert(WORLD, world)
    end
    
    if BOTCOUNT % Bot_Settings.spread ~= 0 then
        error("Not Equal. Cannot Spread " .. Bot_Settings.spread .. " bot per world.")
    end
    
    for i, bot in ipairs(getBots()) do
        WORLD_SPREAD[bot.name] = {{}, 0}
    end
    
    for i = 1, #WORLD do
        
        for j = 1, Bot_Settings.spread do
            bot_index = ((i - 1) * Bot_Settings.spread + j - 1) % BOTCOUNT + 1
            table.insert(WORLD_SPREAD[getBots()[bot_index].name][1], WORLD[i])
            WORLD_SPREAD[getBots()[bot_index].name][2] = j
        end
    end

    if getBot().index == 1 then
        for botName, positions in pairs(WORLD_SPREAD) do
            io.write(botName .. " = ")
            for i, pos in ipairs(positions[1]) do
                io.write(pos)
                if i < #positions[1] then
                    io.write(", ")
                end
            end
            print()
        end 
    end   
    main(getBot().index, WORLD_SPREAD[getBot().name], Bot_Settings, Script_Settings)
else
    WORLD_SPREAD = {{}, 0}
    for world in io.lines(World.file_name) do
        table.insert(WORLD, world)
    end

    bot = getBot()
    WORLD_SPREAD[2] = bot.index
    main(bot.index, WORLD_SPREAD, Bot_Settings, Script_Settings)
end
